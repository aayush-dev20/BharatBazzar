# Haat Marketplace Environment Configuration
# Country code 91, no plus, no spaces
WHATSAPP_NUMBER=919234725874

# Application URL
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Supabase (PostgreSQL with RLS)
NEXT_PUBLIC_SUPABASE_URL=https://your-supabase-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Search Engine (Typesense / Meilisearch)
SEARCH_ENGINE_TYPE=typesense
TYPESENSE_API_KEY=xyz
TYPESENSE_HOST=localhost
TYPESENSE_PORT=8108

# OTP Service (MSG91 / Firebase)
OTP_PROVIDER=simulator
MSG91_AUTH_KEY=
MSG91_TEMPLATE_ID=

# Storage (S3 / Supabase Storage)
STORAGE_BUCKET=haat-product-images
